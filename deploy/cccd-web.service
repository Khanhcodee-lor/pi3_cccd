[Unit]
Description=CCCD NFC web server
After=network-online.target pcscd.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/khanh/p3_cccd
EnvironmentFile=/home/khanh/.config/p3_cccd/web.env
ExecStart=/home/khanh/p3_cccd/.venv/bin/python /home/khanh/p3_cccd/web_server.py --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
